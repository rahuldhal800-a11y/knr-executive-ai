# Primary provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Local model (recommended fallback / your dedicated local model)
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Optional additional OpenAI-compatible providers.
# Keep secrets in environment variables, not this file.
# Example:
# MODEL_PROVIDERS_JSON=[{"name":"provider2","model":"model-id","api_key_env":"PROVIDER2_API_KEY","base_url":"https://provider.example/v1"}]

PROVIDER_COOLDOWN_SECONDS=60
AGENT_MAX_STEPS=24
